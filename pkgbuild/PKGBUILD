# Maintainer: Ciprian Tanana

pkgname=omasign
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple PDF viewer and signer built with Qt Quick'
arch=('x86_64')
url='https://github.com/unTanana/omasign'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'poppler-qt6' 'xdg-desktop-portal' 'hicolor-icon-theme')
makedepends=('gcc' 'make' 'pkgconf' 'qt6-base' 'qt6-declarative' 'poppler-qt6')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omasign "$pkgdir/usr/bin/omasign"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omasign.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasign.svg"
  install -Dm644 "$startdir/omasign.desktop" "$pkgdir/usr/share/applications/omasign.desktop"
}
